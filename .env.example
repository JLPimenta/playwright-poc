# =============================================================================
# Copie para .env e preencha. O .env está no .gitignore — nunca versione tokens.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# --- Credenciais (login em /api/v1/login/access-token) -----------------------
API_USERNAME=
API_PASSWORD=

# --- Janelas de data com massa conhecida (dd-MM-YYYY HH:mm:ss) ---------------
DATA_IN=01-08-2026 00:00:00
DATA_FI=01-08-2026 23:59:59
DATA_IN_WIDE=01-07-2026 00:00:00
DATA_FI_WIDE=31-07-2026 23:59:59
# Dia com massa conhecida, para provar que a data é lida como dia-mês.
# Escolha um dia em que a leitura invertida (MM-dd) não retornaria nada.
DATA_DDMM_DAY=01-02-2026

# --- Ids conhecidos do ambiente (CSV). Vazio = testes do filtro ficam skipped -
EQUIP_IDS=
EQUIP_TYPE_IDS=
EQUIP_GROUP_IDS=
TURN_IDS=
MATERIAL_GROUP_IDS=
MATERIAL_IDS=

# --- Endpoint fuel_management ------------------------------------------------
# Janela com abastecimentos registrados. Sem massa, a rota devolve 204.
FUEL_DATA_IN=01-06-2026 00:00:00
FUEL_DATA_FI=30-06-2026 23:59:59
# Ids de equipamento com abastecimento no período (CSV).
FUEL_EQUIP_IDS=NNN

# --- Elementos de qualidade --------------------------------------------------
# Quantidade cadastrada para o cliente do ambiente. -1 desativa a asserção exata.
EXPECTED_ELEMENT_COUNT=-1

# --- Rate limit --------------------------------------------------------------
# A API limita a LIMIT_REQUESTS/minute por IP (default 10 em utils/consts.py).
# Suba LIMIT_REQUESTS no .env da API ao rodar a suíte, e reflita o valor aqui.
RATE_LIMIT_PER_MINUTE=10
# true = o cliente aguarda e repete no 429, dentro de um orçamento de 6s.
RETRY_ON_RATE_LIMIT=false

# Teto por requisição. O default do Playwright é 30s: duas chamadas travadas em
# sequência já estouram o timeout do teste, e a falha some atrás de
# "Test timeout exceeded" em vez de apontar a requisição que não respondeu.
REQUEST_TIMEOUT_MS=15000

# --- SLA (o critério de aceite não define; estes são os valores propostos) ----
SLA_MS=3000
SLA_MS_WIDE=10000

# --- Diagnóstico -------------------------------------------------------------
# true anexa requisição/resposta ao relatório HTML do Playwright.
LOG_HTTP=false
